<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Số ít/số nhiều. Tiếng Nga: one (1, 21…), few (2–4, 22–24…), many (5–20, 25…), other (số lẻ). -->
<plist version="1.0">
<dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld элемент</string>
			<key>few</key>
			<string>%lld элемента</string>
			<key>many</key>
			<string>%lld элементов</string>
			<key>other</key>
			<string>%lld элемента</string>
		</dict>
	</dict>
	<key>Delete %lld items copied from %@?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Удалить %#@n@ из %@?</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld элемент, скопированный</string>
			<key>few</key>
			<string>%lld элемента, скопированных</string>
			<key>many</key>
			<string>%lld элементов, скопированных</string>
			<key>other</key>
			<string>%lld элемента, скопированных</string>
		</dict>
	</dict>
	<key>%lld characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld символ</string>
			<key>few</key>
			<string>%lld символа</string>
			<key>many</key>
			<string>%lld символов</string>
			<key>other</key>
			<string>%lld символа</string>
		</dict>
	</dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld день</string>
			<key>few</key>
			<string>%lld дня</string>
			<key>many</key>
			<string>%lld дней</string>
			<key>other</key>
			<string>%lld дня</string>
		</dict>
	</dict>
</dict>
</plist>
